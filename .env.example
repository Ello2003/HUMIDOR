# Gemini API key used by the Express API server's research features. It is not required for retailer price scanning.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional Firecrawl API key used only for discovery fallback. Direct retailer scanning does not require it.
FIRECRAWL_API_KEY="MY_FIRECRAWL_API_KEY"

# Optional: restrict browser API requests to the deployed frontend origin.
# Leave unset to allow cross-origin requests from a separately hosted static frontend.
ALLOWED_ORIGIN="https://YOUR-GITHUB-PAGES-ORIGIN"
