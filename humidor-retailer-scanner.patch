+import { describe, expect, it, vi } from 'vitest';
+import {
+  cigarKey,
+  describeAge,
+  findBatchQuotes,
+  findQuotes,
+  loadScanResults,
+  missingFromScan,
+  normaliseKey,
+  retailerSummaryLine,
+  scanAgeHours,
+  scanHealthNote,
+} from './scanResults';
+import { normalise } from '../../scanner/parsers';
+import type { ScanResultsFile } from '../../scanner/types';
+
+const report = (o: Partial<ScanResultsFile['retailers'][number]>) => ({
+  id: 'x', name: 'X', baseUrl: 'https://x', status: 'ok' as const, queries: 4, queriesOk: 4, queriesFailed: 0,
+  productsSeen: 0, quotesKept: 2, skippedMultiPack: 0, skippedCurrency: 0, carriedOver: 0, errors: [], ...o,
+});
+
+const file: ScanResultsFile = {
+  schemaVersion: 1,
+  scannedAt: '2026-10-10T06:00:00.000Z',
+  durationMs: 1000,
+  retailers: [
+    report({ id: 'a', name: 'C.Gars Ltd', status: 'ok' }),
+    report({ id: 'b', name: 'Smoke King', status: 'failed', queriesOk: 0, queriesFailed: 4, quotesKept: 0, errors: [{ query: 'q', kind: 'blocked', message: 'HTTP 403 -- looks like a bot wall' }] }),
+    report({ id: 'c', name: "Holt's", status: 'disabled', note: 'US retailer' }),
+  ],
+  items: [
+    { brand: 'Padrón', line: '1964 Anniversary', vitola: 'Exclusivo', quotes: [{ vendor: 'C.Gars Ltd', price: 16, currency: 'GBP', packageType: 'Single', inStock: true, title: 'Padron 1964 Exclusivo', url: 'https://x/p', scannedAt: '2026-10-09T06:00:00.000Z' }] },
+    { brand: 'Cohiba', line: 'Behike', vitola: 'BHK 52', quotes: [] },
+  ],
+};
+
+describe('normaliseKey', () => {
+  it('stays identical to the scanner normalise()', () => {
+    for (const s of ['Padrón 1964 & Co.', "Holt's  Cigar", 'H. Upmann — No. 2', '']) {
+      expect(normaliseKey(s)).toBe(normalise(s));
+    }
+  });
+});
+
+describe('findQuotes', () => {
+  it('matches accents/case and converts to app shape (£ symbol, scan date)', () => {
+    const q = findQuotes(file, { brand: 'padron', line: '1964 anniversary', vitola: 'EXCLUSIVO' });
+    expect(q).toHaveLength(1);
+    expect(q[0]).toMatchObject({ vendor: 'C.Gars Ltd', price: 16, currency: '£', packageType: 'Single', inStock: true, recordedAt: '2026-10-09T06:00:00.000Z' });
+  });
+  it('does not match a different vitola', () => {
+    expect(findQuotes(file, { brand: 'Padrón', line: '1964 Anniversary', vitola: 'Imperial' })).toEqual([]);
+  });
+  it('lets a vitola-less item use an unambiguous line-level hit', () => {
+    expect(findQuotes(file, { brand: 'Padrón', line: '1964 Anniversary' })).toHaveLength(1);
+  });
+  it('refuses an ambiguous vitola-less match', () => {
+    const two: ScanResultsFile = { ...file, items: [file.items[0], { ...file.items[0], vitola: 'Imperial' }] };
+    expect(findQuotes(two, { brand: 'Padrón', line: '1964 Anniversary' })).toEqual([]);
+  });
+});
+
+describe('findBatchQuotes / missingFromScan', () => {
+  it('returns one result per cigar, keeping ids', () => {
+    const out = findBatchQuotes(file, [
+      { id: '1', brand: 'Padrón', line: '1964 Anniversary', vitola: 'Exclusivo' },
+      { id: '2', brand: 'Cohiba', line: 'Behike', vitola: 'BHK 52' },
+    ]);
+    expect(out.map((o) => [o.id, o.quotes.length])).toEqual([['1', 1], ['2', 0]]);
+  });
+  it('lists cigars the scanner has never heard of, once each', () => {
+    const missing = missingFromScan(file, [
+      { brand: 'Padrón', line: '1964 Anniversary', vitola: 'Exclusivo' },
+      { brand: 'Montecristo', line: 'No. 2', vitola: 'Torpedo' },
+      { brand: 'montecristo', line: 'no 2', vitola: 'torpedo' },
+    ]);
+    expect(missing).toEqual([{ brand: 'Montecristo', line: 'No. 2', vitola: 'Torpedo' }]);
+  });
+  it('cigarKey ignores an absent vitola', () => {
+    expect(cigarKey({ brand: 'A', line: 'B' })).toBe('a b');
+  });
+});
+
+describe('status helpers', () => {
+  const now = new Date('2026-10-12T06:00:00.000Z');
+  it('computes and describes age', () => {
+    expect(scanAgeHours(file, now)).toBeCloseTo(48);
+    expect(describeAge(48)).toBe('2 days ago');
+    expect(describeAge(5)).toBe('5h ago');
+    expect(describeAge(0.2)).toBe('less than an hour ago');
+    expect(describeAge(null)).toBe('never');
+  });
+  it('counts only enabled retailers in the health note', () => {
+    expect(scanHealthNote(file, now)).toBe('1 of 2 retailers returned prices (scanned 2 days ago).');
+  });
+  it('says so when the scanner has never run', () => {
+    expect(scanHealthNote({ ...file, scannedAt: null }, now)).toMatch(/has not run yet/);
+  });
+  it('explains each retailer state', () => {
+    expect(retailerSummaryLine(file.retailers[0])).toBe('2 prices');
+    expect(retailerSummaryLine(file.retailers[1])).toMatch(/blocked: HTTP 403/);
+    expect(retailerSummaryLine(file.retailers[2])).toBe('US retailer');
+    expect(retailerSummaryLine(report({ status: 'no_matches', quotesKept: 0 }))).toMatch(/nothing matched/);
+  });
+});
+
+describe('loadScanResults', () => {
+  it('cache-busts and parses a valid file', async () => {
+    const fetchFn = vi.fn().mockResolvedValue({ ok: true, json: async () => file });
+    const out = await loadScanResults(fetchFn as any, '/HUMIDOR/');
+    expect(out.items).toHaveLength(2);
+    expect(fetchFn.mock.calls[0][0]).toMatch(/^\/HUMIDOR\/data\/retailer-prices\.json\?t=\d+$/);
+  });
+  it('throws a readable error on 404 and on a bad shape', async () => {
+    await expect(loadScanResults(vi.fn().mockResolvedValue({ ok: false, status: 404 }) as any, '/')).rejects.toThrow(/HTTP 404/);
+    await expect(loadScanResults(vi.fn().mockResolvedValue({ ok: true, json: async () => ({}) }) as any, '/')).rejects.toThrow(/unexpected format/);
+  });
+});
diff --git a/src/utils/scanResults.ts b/src/utils/scanResults.ts
new file mode 100644
index 0000000..c85575c
--- /dev/null
+++ b/src/utils/scanResults.ts
@@ -0,0 +1,122 @@
+/**
+ * Browser-side reader for public/data/retailer-prices.json, the file the
+ * scheduled "Scan retailer prices" GitHub Action commits. The Wishlist and
+ * Research Hub scan buttons read it instead of calling the old /api routes,
+ * so they work on GitHub Pages (no server) and never touch a retailer from
+ * the browser.
+ *
+ * Types are imported type-only from scanner/ so nothing scanner-side (cheerio
+ * etc.) lands in the browser bundle.
+ */
+import type { RetailerReport, ScanItem, ScanQuote, ScanResultsFile, WatchlistEntry } from '../../scanner/types';
+import type { VendorPriceEntry } from '../types';
+import { canonicalizeVendorName } from './researchUtils';
+
+export type { RetailerReport, ScanResultsFile, WatchlistEntry };
+
+/** Must stay identical to normalise() in scanner/parsers.ts (a test enforces it). */
+export function normaliseKey(text: string): string {
+  return text
+    .normalize('NFD')
+    .replace(/[\u0300-\u036f]/g, '')
+    .toLowerCase()
+    .replace(/&/g, ' and ')
+    .replace(/[^a-z0-9]+/g, ' ')
+    .trim();
+}
+
+export function cigarKey(c: { brand: string; line: string; vitola?: string }): string {
+  return normaliseKey(`${c.brand} ${c.line} ${c.vitola ?? ''}`);
+}
+
+export const SCAN_RESULTS_STALE_AFTER_HOURS = 72;
+
+export async function loadScanResults(fetchFn: typeof fetch = fetch, baseUrl: string = import.meta.env.BASE_URL): Promise<ScanResultsFile> {
+  // Cache-bust: GitHub Pages / browsers can otherwise serve yesterday's file.
+  const url = `${baseUrl}data/retailer-prices.json?t=${Date.now()}`;
+  const res = await fetchFn(url, { cache: 'no-store' });
+  if (!res.ok) throw new Error(`Couldn't load scan results (HTTP ${res.status}). The scanner may not have run yet.`);
+  const json = (await res.json()) as ScanResultsFile;
+  if (json?.schemaVersion !== 1 || !Array.isArray(json.items) || !Array.isArray(json.retailers)) {
+    throw new Error('Scan results file is in an unexpected format.');
+  }
+  return json;
+}
+
+export function toVendorEntry(q: ScanQuote): VendorPriceEntry {
+  return {
+    id: `vp-${Date.now()}-${Math.random().toString(36).substring(2, 6)}`,
+    vendor: canonicalizeVendorName(q.vendor),
+    price: q.price,
+    currency: '£',
+    packageType: 'Single',
+    inStock: q.inStock,
+    url: q.url,
+    // The date the retailer's price was actually read, not "now".
+    recordedAt: q.scannedAt,
+  };
+}
+
+/** Quotes for one cigar. Exact brand+line+vitola; vitola-less app items may use a line-level hit. */
+export function findQuotes(results: ScanResultsFile, c: { brand: string; line: string; vitola?: string }): VendorPriceEntry[] {
+  const wanted = cigarKey(c);
+  let item: ScanItem | undefined = results.items.find((i) => cigarKey(i) === wanted);
+  if (!item && !c.vitola) {
+    const lineKey = cigarKey({ brand: c.brand, line: c.line });
+    const candidates = results.items.filter((i) => cigarKey({ brand: i.brand, line: i.line }) === lineKey && i.quotes.length > 0);
+    if (candidates.length === 1) item = candidates[0];
+  }
+  return (item?.quotes ?? []).map(toVendorEntry);
+}
+
+export function findBatchQuotes<T extends { id: string; brand: string; line: string; vitola?: string }>(
+  results: ScanResultsFile,
+  cigars: T[]
+): Array<{ id: string; brand: string; name: string; quotes: VendorPriceEntry[] }> {
+  return cigars.map((c) => ({ id: c.id, brand: c.brand, name: c.line, quotes: findQuotes(results, c) }));
+}
+
+/** App cigars the scanner doesn't know about (so they'd never get a price). */
+export function missingFromScan(results: ScanResultsFile, cigars: Array<{ brand: string; line: string; vitola?: string }>): WatchlistEntry[] {
+  const known = new Set(results.items.map(cigarKey));
+  const seen = new Set<string>();
+  const out: WatchlistEntry[] = [];
+  for (const c of cigars) {
+    const k = cigarKey(c);
+    if (!c.brand || !c.line || known.has(k) || seen.has(k)) continue;
+    seen.add(k);
+    out.push({ brand: c.brand, line: c.line, ...(c.vitola ? { vitola: c.vitola } : {}) });
+  }
+  return out;
+}
+
+export function scanAgeHours(results: ScanResultsFile, now: Date = new Date()): number | null {
+  if (!results.scannedAt) return null;
+  return (now.getTime() - new Date(results.scannedAt).getTime()) / 3_600_000;
+}
+
+export function describeAge(hours: number | null): string {
+  if (hours === null) return 'never';
+  if (hours < 1) return 'less than an hour ago';
+  if (hours < 48) return `${Math.round(hours)}h ago`;
+  return `${Math.round(hours / 24)} days ago`;
+}
+
+/** One line for the toast after pressing a scan button. */
+export function scanHealthNote(results: ScanResultsFile, now: Date = new Date()): string {
+  if (!results.scannedAt) return 'The scanner has not run yet — run the "Scan retailer prices" workflow in GitHub Actions.';
+  const active = results.retailers.filter((r) => r.status !== 'disabled');
+  const working = active.filter((r) => r.status === 'ok' || r.status === 'partial').length;
+  const age = describeAge(scanAgeHours(results, now));
+  return `${working} of ${active.length} retailers returned prices (scanned ${age}).`;
+}
+
+export function retailerSummaryLine(r: RetailerReport): string {
+  if (r.status === 'disabled') return r.note ?? 'Disabled';
+  if (r.status === 'no_matches') return 'Reachable, but nothing matched — the search URL or selectors need fixing';
+  const first = r.errors[0];
+  if (r.status === 'failed' || r.status === 'partial') {
+    return first ? `${first.kind}: ${first.message}` : `${r.queriesFailed} of ${r.queries} lookups failed`;
+  }
+  return `${r.quotesKept} price${r.quotesKept === 1 ? '' : 's'}${r.carriedOver ? `, ${r.carriedOver} carried over` : ''}`;
+}
