diff --git a/scanner/parsers.test.ts b/scanner/parsers.test.ts
new file mode 100644
index 0000000..baf9379
--- /dev/null
+++ b/scanner/parsers.test.ts
@@ -0,0 +1,181 @@
+import { describe, expect, it } from 'vitest';
+import {
+  detectPackageType,
+  looksBlocked,
+  parseHtmlSearch,
+  parseJsonLdProducts,
+  parsePrice,
+  parseProductCards,
+  parseShopifySuggest,
+  pickBest,
+  titleMatches,
+} from './parsers';
+
+const BASE = 'https://shop.example.co.uk';
+
+describe('parsePrice', () => {
+  it('handles currency symbols, thousands separators and plain numbers', () => {
+    expect(parsePrice('£12.50')).toBe(12.5);
+    expect(parsePrice('£1,250.00')).toBe(1250);
+    expect(parsePrice('12.5')).toBe(12.5);
+    expect(parsePrice(14.8)).toBe(14.8);
+  });
+  it('handles a European decimal comma', () => {
+    expect(parsePrice('12,50')).toBe(12.5);
+  });
+  it('rejects garbage, zero and negatives', () => {
+    expect(parsePrice('')).toBeNull();
+    expect(parsePrice('Price on request')).toBeNull();
+    expect(parsePrice('0.00')).toBeNull();
+    expect(parsePrice(undefined)).toBeNull();
+  });
+});
+
+describe('detectPackageType', () => {
+  it.each([
+    ['Padron 1964 Anniversary Exclusivo', 'Single'],
+    ['Padron 1964 Exclusivo Box of 25', 'Multi'],
+    ['Padron 1964 Exclusivo - Pack of 5', 'Multi'],
+    ['Padron 1964 Exclusivo 5 Pack', 'Multi'],
+    ['Cohiba Siglo VI Sampler', 'Multi'],
+    ['Cohiba Siglo VI Tin of 3', 'Multi'],
+  ])('%s -> %s', (title, expected) => {
+    expect(detectPackageType(title)).toBe(expected);
+  });
+});
+
+describe('titleMatches', () => {
+  const padron = { brand: 'Padrón', line: '1964 Anniversary Series', vitola: 'Exclusivo (Box-Pressed Robusto)' };
+
+  it('matches despite accents and extra words', () => {
+    expect(titleMatches('Padron 1964 Anniversary Series Exclusivo Maduro', padron)).toBe(true);
+  });
+  it('rejects the wrong brand', () => {
+    expect(titleMatches('Davidoff 1964 Anniversary Exclusivo', padron)).toBe(false);
+  });
+  it('rejects the right line but the wrong vitola (wrong size = wrong price)', () => {
+    expect(titleMatches('Padron 1964 Anniversary Series Monarca', padron)).toBe(false);
+  });
+  it('rejects a different line from the same brand', () => {
+    expect(titleMatches('Padron Serie 1926 No. 9 Exclusivo', padron)).toBe(false);
+  });
+  it('matches when no vitola is specified', () => {
+    expect(titleMatches('Padron 1964 Anniversary Monarca', { brand: 'Padrón', line: '1964 Anniversary Series' })).toBe(true);
+  });
+  it('does not treat a brand-only mention as a match for a specific line', () => {
+    expect(titleMatches('Casdagli Club Series Robusto', { brand: 'Casdagli', line: 'Daughters of the Wind Calico', vitola: 'Corona Gorda' })).toBe(false);
+  });
+});
+
+describe('parseShopifySuggest', () => {
+  const fixture = {
+    resources: {
+      results: {
+        products: [
+          { title: 'Padron 1964 Anniversary Exclusivo', url: '/products/padron-1964-exclusivo?_pos=1', price: '16.50', available: true },
+          { title: 'Padron 1964 Exclusivo Box of 25', url: '/products/padron-1964-exclusivo-box', price: '395.00', available: false },
+          { title: 'Broken product with no price', url: '/products/x', price: '' },
+        ],
+      },
+    },
+  };
+
+  it('extracts products, resolves relative URLs and availability', () => {
+    const out = parseShopifySuggest(fixture, BASE)!;
+    expect(out).toHaveLength(2);
+    expect(out[0]).toMatchObject({ price: 16.5, inStock: true, url: `${BASE}/products/padron-1964-exclusivo?_pos=1` });
+    expect(out[1].inStock).toBe(false);
+  });
+  it('returns null (not []) when the response is not a Shopify suggest payload', () => {
+    expect(parseShopifySuggest({ hello: 'world' }, BASE)).toBeNull();
+    expect(parseShopifySuggest(null, BASE)).toBeNull();
+  });
+  it('returns [] for a valid payload with no products', () => {
+    expect(parseShopifySuggest({ resources: { results: { products: [] } } }, BASE)).toEqual([]);
+  });
+});
+
+describe('parseJsonLdProducts', () => {
+  const single = `<html><head><script type="application/ld+json">
+    {"@context":"https://schema.org","@type":"Product","name":"Padron 1964 Exclusivo","url":"/p/padron",
+     "offers":{"@type":"Offer","price":"15.20","priceCurrency":"GBP","availability":"https://schema.org/InStock"}}
+  </script></head></html>`;
+
+  const graphAndList = `<script type="application/ld+json">{"@graph":[
+      {"@type":"BreadcrumbList"},
+      {"@type":"ItemList","itemListElement":[
+        {"@type":"ListItem","item":{"@type":"Product","name":"A Cigar","offers":[{"price":"9.00","priceCurrency":"GBP","availability":"OutOfStock"}]}},
+        {"@type":"ListItem","item":{"@type":"Product","name":"B Cigar","offers":{"@type":"AggregateOffer","lowPrice":"7.50","priceCurrency":"EUR"}}}
+      ]}]}</script>`;
+
+  it('reads a single Product', () => {
+    expect(parseJsonLdProducts(single, BASE)).toEqual([
+      { title: 'Padron 1964 Exclusivo', price: 15.2, currency: 'GBP', inStock: true, url: `${BASE}/p/padron` },
+    ]);
+  });
+  it('walks @graph / ItemList nesting, offer arrays and AggregateOffer, and reads stock + currency', () => {
+    const out = parseJsonLdProducts(graphAndList, BASE);
+    expect(out.map((p) => [p.title, p.price, p.currency, p.inStock])).toEqual([
+      ['A Cigar', 9, 'GBP', false],
+      ['B Cigar', 7.5, 'EUR', true],
+    ]);
+  });
+  it('survives malformed JSON-LD blocks next to good ones', () => {
+    const html = `<script type="application/ld+json">{ not json</script>${single}`;
+    expect(parseJsonLdProducts(html, BASE)).toHaveLength(1);
+  });
+});
+
+describe('parseProductCards (WooCommerce / Magento fallback)', () => {
+  const woo = `<ul class="products">
+    <li class="product"><a class="woocommerce-LoopProduct-link" href="/product/padron-1964/">
+      <h2 class="woocommerce-loop-product__title">Padron 1964 Exclusivo</h2>
+      <span class="price"><del><span class="amount">£18.00</span></del><ins><span class="amount">£16.00</span></ins></span></a></li>
+    <li class="product outofstock"><a class="woocommerce-LoopProduct-link" href="/product/other/">
+      <h2 class="woocommerce-loop-product__title">Other Cigar</h2><span class="price"><span class="amount">£5.00</span></span>
+      <span>Out of stock</span></a></li>
+  </ul>`;
+
+  it('reads WooCommerce cards, preferring the sale price and flagging out-of-stock', () => {
+    const out = parseProductCards(woo, BASE);
+    expect(out).toHaveLength(2);
+    expect(out[0]).toMatchObject({ title: 'Padron 1964 Exclusivo', price: 16, currency: 'GBP', inStock: true, url: `${BASE}/product/padron-1964/` });
+    expect(out[1].inStock).toBe(false);
+  });
+  it('returns [] when the page has no recognisable product cards', () => {
+    expect(parseProductCards('<html><body><p>No results</p></body></html>', BASE)).toEqual([]);
+  });
+  it('parseHtmlSearch prefers JSON-LD and falls back to cards', () => {
+    expect(parseHtmlSearch(woo, BASE)).toHaveLength(2);
+    const both = `<script type="application/ld+json">{"@type":"Product","name":"LD","offers":{"price":"1.00"}}</script>${woo}`;
+    expect(parseHtmlSearch(both, BASE).map((p) => p.title)).toEqual(['LD']);
+  });
+});
+
+describe('looksBlocked', () => {
+  it('recognises a Cloudflare challenge', () => {
+    expect(looksBlocked(403, '<title>Just a moment...</title>')).toBe(true);
+    expect(looksBlocked(503, 'cf-chl-bypass')).toBe(true);
+  });
+  it('treats 403 and 429 as blocked even without a recognisable body', () => {
+    expect(looksBlocked(403, '')).toBe(true);
+    expect(looksBlocked(429, '')).toBe(true);
+  });
+  it('does not call an ordinary 404 or 500 a block', () => {
+    expect(looksBlocked(404, 'Not found')).toBe(false);
+    expect(looksBlocked(500, 'oops')).toBe(false);
+  });
+});
+
+describe('pickBest', () => {
+  const mk = (price: number, inStock: boolean) => ({ title: 't', price, inStock });
+  it('prefers the cheapest in-stock price', () => {
+    expect(pickBest([mk(10, false), mk(14, true), mk(12, true)])?.price).toBe(12);
+  });
+  it('falls back to cheapest overall when nothing is in stock', () => {
+    expect(pickBest([mk(10, false), mk(9, false)])?.price).toBe(9);
+  });
+  it('returns undefined for no products', () => {
+    expect(pickBest([])).toBeUndefined();
+  });
+});
diff --git a/scanner/parsers.ts b/scanner/parsers.ts
new file mode 100644
index 0000000..f34bc79
--- /dev/null
+++ b/scanner/parsers.ts
@@ -0,0 +1,227 @@
+import * as cheerio from 'cheerio';
+import type { ScanErrorKind, WatchlistEntry } from './types';
+
+/** A product as read from a retailer page, before matching/filtering. */
+export interface RawProduct {
+  title: string;
+  /** Price in the page's own currency, as a number. */
+  price: number;
+  /** ISO code if the page said (e.g. 'GBP'); undefined if it didn't. */
+  currency?: string;
+  inStock: boolean;
+  url?: string;
+}
+
+// ---------------------------------------------------------------- text utils
+
+export function normalise(text: string): string {
+  return text
+    .normalize('NFD')
+    .replace(/[\u0300-\u036f]/g, '')
+    .toLowerCase()
+    .replace(/&/g, ' and ')
+    .replace(/[^a-z0-9]+/g, ' ')
+    .trim();
+}
+
+const FILLER = new Set(['cigar', 'cigars', 'the', 'co', 'company', 'ltd', 'and', 'of', 'no', 'number', 'series']);
+
+function significantTokens(text: string): string[] {
+  return normalise(text)
+    .split(' ')
+    .filter((t) => t.length > 0 && !FILLER.has(t));
+}
+
+/** "£1,250.00" / "12.5" / "12,50" -> number, or null if there's no sane price. */
+export function parsePrice(raw: string | number | undefined | null): number | null {
+  if (raw === undefined || raw === null) return null;
+  if (typeof raw === 'number') return Number.isFinite(raw) && raw > 0 ? raw : null;
+  const m = raw.replace(/\s/g, '').match(/(\d[\d,]*(?:\.\d+)?|\d+,\d{1,2})/);
+  if (!m) return null;
+  let s = m[1];
+  // "12,50" (European decimal comma) vs "1,250" / "1,250.00" (thousands)
+  if (/^\d+,\d{1,2}$/.test(s)) s = s.replace(',', '.');
+  else s = s.replace(/,/g, '');
+  const n = Number(s);
+  return Number.isFinite(n) && n > 0 ? n : null;
+}
+
+export function detectPackageType(title: string): 'Single' | 'Multi' {
+  const t = title.toLowerCase();
+  if (/\b(box|tin|case|carton|bundle|sampler|selection|collection|gift set)\b/.test(t)) return 'Multi';
+  if (/\b(pack|pk)\s*(of)?\s*\d+\b/.test(t) || /\b\d+\s*(pack|pk|cigars|x)\b/.test(t)) return 'Multi';
+  if (/\bof\s*(3|5|6|8|10|12|13|15|20|24|25|30|50)\b/.test(t)) return 'Multi';
+  return 'Single';
+}
+
+// ------------------------------------------------------------------ matching
+
+/**
+ * Does this retailer product title plausibly be the cigar we asked for?
+ * Deliberately strict: a missed match shows as "no price found", a wrong match
+ * shows a wrong price, and the second is worse.
+ */
+export function titleMatches(title: string, wanted: WatchlistEntry): boolean {
+  const t = new Set(normalise(title).split(' '));
+  const titleText = ` ${normalise(title)} `;
+
+  const brandTokens = significantTokens(wanted.brand);
+  if (brandTokens.length > 0 && !brandTokens.every((b) => t.has(b))) return false;
+
+  const lineTokens = significantTokens(wanted.line).filter((tok) => !brandTokens.includes(tok));
+  if (lineTokens.length > 0) {
+    const hits = lineTokens.filter((tok) => t.has(tok)).length;
+    if (hits / lineTokens.length < 0.75) return false;
+  }
+
+  if (wanted.vitola) {
+    // "Exclusivo (Box-Pressed Robusto)" -> the part before the bracket is the vitola name.
+    const primary = wanted.vitola.split('(')[0];
+    const vitolaTokens = significantTokens(primary).filter((tok) => !brandTokens.includes(tok) && !lineTokens.includes(tok));
+    if (vitolaTokens.length > 0 && !vitolaTokens.every((v) => titleText.includes(` ${v} `))) return false;
+  }
+  return true;
+}
+
+// ---------------------------------------------------------------- strategies
+
+/** Shopify predictive search: GET /search/suggest.json?q=...&resources[type]=product */
+export function parseShopifySuggest(json: unknown, baseUrl: string): RawProduct[] | null {
+  const products = (json as any)?.resources?.results?.products;
+  if (!Array.isArray(products)) return null;
+  const out: RawProduct[] = [];
+  for (const p of products) {
+    const price = parsePrice(p?.price);
+    if (!p?.title || price === null) continue;
+    out.push({
+      title: String(p.title),
+      price,
+      // Shopify's suggest endpoint reports the shop's own currency without naming it;
+      // the retailer config is UK-only, so the caller treats undefined as GBP.
+      currency: undefined,
+      inStock: p.available !== false,
+      url: p.url ? new URL(String(p.url), baseUrl).toString() : undefined,
+    });
+  }
+  return out;
+}
+
+function asArray<T>(v: T | T[] | undefined | null): T[] {
+  return v === undefined || v === null ? [] : Array.isArray(v) ? v : [v];
+}
+
+function collectJsonLdProducts(node: any, into: any[]): void {
+  if (!node || typeof node !== 'object') return;
+  if (Array.isArray(node)) {
+    node.forEach((n) => collectJsonLdProducts(n, into));
+    return;
+  }
+  const types = asArray(node['@type']).map(String);
+  if (types.includes('Product')) into.push(node);
+  for (const key of ['@graph', 'itemListElement', 'item', 'mainEntity']) {
+    if (node[key]) collectJsonLdProducts(node[key], into);
+  }
+}
+
+export function parseJsonLdProducts(html: string, baseUrl: string): RawProduct[] {
+  const $ = cheerio.load(html);
+  const found: any[] = [];
+  $('script[type="application/ld+json"]').each((_, el) => {
+    try {
+      collectJsonLdProducts(JSON.parse($(el).contents().text()), found);
+    } catch {
+      /* malformed JSON-LD block -- ignore it, others may be fine */
+    }
+  });
+
+  const out: RawProduct[] = [];
+  for (const p of found) {
+    const offers = asArray(p.offers).flatMap((o: any) => (o?.offers ? asArray(o.offers) : [o]));
+    const offer = offers.find((o: any) => parsePrice(o?.price ?? o?.lowPrice) !== null);
+    if (!p.name || !offer) continue;
+    const price = parsePrice(offer.price ?? offer.lowPrice);
+    if (price === null) continue;
+    out.push({
+      title: String(p.name),
+      price,
+      currency: offer.priceCurrency ? String(offer.priceCurrency).toUpperCase() : undefined,
+      inStock: !/OutOfStock|SoldOut|Discontinued/i.test(String(offer.availability ?? '')),
+      url: p.url ? new URL(String(p.url), baseUrl).toString() : offer.url ? new URL(String(offer.url), baseUrl).toString() : undefined,
+    });
+  }
+  return out;
+}
+
+export interface CardSelectors {
+  card: string;
+  title: string;
+  price: string;
+  link: string;
+}
+
+/** Defaults cover the two common non-Shopify UK shop platforms. */
+export const DEFAULT_CARD_SELECTORS: CardSelectors[] = [
+  // WooCommerce
+  { card: 'li.product', title: '.woocommerce-loop-product__title, h2, h3', price: '.price ins .amount, .price .amount, .price', link: 'a.woocommerce-LoopProduct-link, a' },
+  // Magento
+  { card: 'li.product-item, .product-item', title: '.product-item-link, .product-name a', price: '.price', link: '.product-item-link, a' },
+  // Generic microdata
+  { card: '[itemtype*="schema.org/Product"]', title: '[itemprop="name"]', price: '[itemprop="price"], .price', link: 'a' },
+];
+
+export function parseProductCards(html: string, baseUrl: string, selectors: CardSelectors[] = DEFAULT_CARD_SELECTORS): RawProduct[] {
+  const $ = cheerio.load(html);
+  for (const sel of selectors) {
+    const out: RawProduct[] = [];
+    $(sel.card).each((_, el) => {
+      const card = $(el);
+      const title = card.find(sel.title).first().text().trim();
+      // A comma selector matches in document order, so a struck-through old price
+      // (<del>) would beat the sale price (<ins>). Try each alternative in the
+      // order written instead, so the most specific selector wins.
+      let price: number | null = null;
+      for (const alt of sel.price.split(',').map((s) => s.trim()).filter(Boolean)) {
+        const el2 = card.find(alt).first();
+        if (el2.length === 0) continue;
+        price = parsePrice(el2.attr('content') ?? el2.text());
+        if (price !== null) break;
+      }
+      if (!title || price === null) return;
+      const href = card.find(sel.link).first().attr('href');
+      out.push({
+        title,
+        price,
+        currency: /£/.test(card.text()) ? 'GBP' : undefined,
+        inStock: !/out of stock|sold out/i.test(card.text()),
+        url: href ? new URL(href, baseUrl).toString() : undefined,
+      });
+    });
+    if (out.length > 0) return out;
+  }
+  return [];
+}
+
+/** HTML search page -> products, trying JSON-LD first and then product cards. */
+export function parseHtmlSearch(html: string, baseUrl: string, selectors?: CardSelectors): RawProduct[] {
+  const fromJsonLd = parseJsonLdProducts(html, baseUrl);
+  if (fromJsonLd.length > 0) return fromJsonLd;
+  return parseProductCards(html, baseUrl, selectors ? [selectors] : DEFAULT_CARD_SELECTORS);
+}
+
+// --------------------------------------------------------------- diagnostics
+
+/** Cloudflare / bot-wall pages come back as 403/429/503 with a recognisable body. */
+export function looksBlocked(status: number, body: string): boolean {
+  if (![401, 403, 429, 503].includes(status)) return false;
+  return /just a moment|cf-chl|attention required|captcha|access denied|are you a robot|checking your browser/i.test(body) || status === 403 || status === 429;
+}
+
+export function classifyHttpFailure(status: number, body: string): ScanErrorKind {
+  return looksBlocked(status, body) ? 'blocked' : 'http';
+}
+
+/** Pick the quote to keep for one retailer x cigar: cheapest in-stock single, else cheapest single. */
+export function pickBest(products: RawProduct[]): RawProduct | undefined {
+  const sorted = [...products].sort((a, b) => a.price - b.price);
+  return sorted.find((p) => p.inStock) ?? sorted[0];
+}
