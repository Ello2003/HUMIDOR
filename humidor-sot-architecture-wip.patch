+/**
+ * Infers a UK/US cigar retailer's display name from a hostname, URL, page
+ * title, or any other free text that might contain its domain or brand
+ * name.
+ *
+ * This one function replaces what used to be two separate, independently
+ * maintained copies of the same if/else-if chain (one here, one -- calling
+ * itself `detectVendorFromText` -- further down this file), each one
+ * claiming in its own comment to be *the* consolidated version. They had
+ * already drifted apart: one recognised "jjfox.co.uk" as James J. Fox
+ * (London) and the Famous Smoke/Holt's branches, the other recognised
+ * Gotham Cigars/Cigars International/Cigarworld, and neither recognised
+ * everything the other did. Add a new retailer once, here, and every import
+ * path benefits.
+ */
+function inferVendorFromHints(text: string, fallback: string): string {
+  const check = String(text || '').toLowerCase();
+  const rules: Array<[RegExp | string, string]> = [
+    [/cgars|c-gars|cgarsltd/, 'C.Gars Ltd (UK)'],
+    ['havanahouse', 'Havana House (UK)'],
+    [/smoke-king|smokeking/, 'Smoke King (UK)'],
+    ['sautter', 'Sautter Cigars (London)'],
+    [/jjfox|james j fox/, 'James J. Fox (London)'],
+    ['davidoff', 'Davidoff of London'],
+    ['foxcigar', 'Fox Cigar'],
+    [/neptunecigar|neptune/, 'Neptune Cigar'],
+    ['famous-smoke', 'Famous Smoke Shop'],
+    ['holts', "Holt's Cigar Co."],
+    ['gotham', 'Gotham Cigars'],
+    ['cigarsinternational', 'Cigars International'],
+    ['cigarworld', 'Cigarworld'],
+  ];
+  for (const [match, vendor] of rules) {
+    if (typeof match === 'string' ? check.includes(match) : match.test(check)) return vendor;
+  }
+  return fallback;
+}
+
+/**
+ * Picks the grounded search source that best belongs to a retailer name.
+ * Gemini returns titles like "cgarsltd.co.uk", which never contain a vendor
+ * string like "C.Gars Ltd" verbatim, so compare with punctuation/spacing
+ * stripped from both sides.
+ */
+function findSourceForVendor(
+  sources: Array<{ title: string; uri: string }>,
+  vendor: string,
+): { title: string; uri: string } | undefined {
+  const compact = (v: string) => String(v || "").toLowerCase().replace(/[^a-z0-9]+/g, "");
+  const vendorWords = String(vendor || "")
+    .toLowerCase()
+    .split(/[\s.()]+/)
+    .map(compact)
+    .filter((w) => w.length >= 3 && !["ltd", "the", "london", "cigars", "tobacconist", "tobacconists"].includes(w));
+  if (!vendorWords.length) return undefined;
+  return sources.find((src) => {
+    const hay = compact(src.title) + compact(src.uri);
+    return vendorWords.some((w) => hay.includes(w));
+  });
+}
